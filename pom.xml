        <!--
            kubernetes-client needs commons-compress to tar a directory up for a pod upload, but it
            declares the dependency <optional>, so it never reaches anything that depends on this
            library. Without a declaration here the classpath falls back to whatever else drags
            commons-compress in — hadoop-common 2.10.0 wins with 1.19 — and PodUpload.addFileToTar
            dies with NoSuchMethodError on TarArchiveOutputStream.putArchiveEntry(TarArchiveEntry).
            That overload only exists from commons-compress 1.25.0; 1.19 through 1.24 have nothing
            but the ArchiveEntry signature.

            ${commons-compress.version} is what kubernetes-client is built against. It needs
            commons-lang3 3.14 and commons-io 2.15 at a minimum — 1.26 reaches for
            commons-lang3 SystemProperties and ArrayFill — which is why those two move with it here.

            It is declared directly, not managed, so that consumers of this library resolve it too.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>${commons-compress.version}</version>
